{
  "name": "url-safe-string",
  "version": "2.0.0",
  "engines": {
    "node": ">=14"
  },
  "description": "Dependency free module to convert strings into URL-safe slugs. Use for routing, SEO, permalinks, or any place you need a clean, URL-friendly string.",
  "main": "url-safe-string.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./url-safe-string.js",
      "types": "./index.d.ts"
    }
  },
  "files": [
    "url-safe-string.js",
    "index.mjs",
    "index.d.ts"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-r-d/url-safe-string.git"
  },
  "keywords": [
    "url",
    "slug",
    "slugify",
    "url-safe",
    "url-slug",
    "url-friendly",
    "sanitize",
    "permalink",
    "seo",
    "routing",
    "string",
    "tag",
    "clean-url",
    "text-to-slug",
    "hyphenate",
    "parameterize",
    "URL safe String",
    "String to URL",
    "String to URL tag",
    "text to URL safe tag"
  ],
  "author": "Aaron Decker <aaron@ard.ninja> (http://ard.ninja)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/a-r-d/url-safe-string/issues"
  },
  "homepage": "https://github.com/a-r-d/url-safe-string#readme",
  "devDependencies": {
    "vitest": "^3.1.1"
  }
}
